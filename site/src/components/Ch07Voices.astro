---
import { getCollection } from 'astro:content';
import Chapter from './Chapter.astro';
import Pic from './Pic.astro';

const voices = (await getCollection('voices')).sort((a, b) => a.data.order - b.data.order);
---

<Chapter id="voices" num="07" title="Voices" class="grain">
  <div class="absolute inset-0 opacity-60" aria-hidden="true">
    <Pic id="bg-quiet-dark-02" sizes="100vw" alt="" class="h-full w-full object-cover" />
  </div>

  <div class="container-wide relative z-10 pb-32 md:pb-44">
    <!-- The testimony itself is the monument: no imagery, no decoration. -->
    <div class="grid grid-cols-12 gap-x-6 gap-y-10 pt-6 md:pt-10">
      <div class="col-span-12 md:col-span-4" data-reveal>
        <div class="md:sticky md:top-24">
          <h2 class="heading-2 max-w-[16ch] text-cream" id="voices-title">The record told through lives.</h2>
          <p class="body-copy mt-5 max-w-[36ch] text-[0.98rem] text-mist-bright">
            Behind every number, a life changed. Testimony is presented here the way a museum
            presents it — at full size, without decoration.
          </p>
          <p class="stamp mt-8 max-w-[36ch] text-mist/80">
            Representative testimonies from the programmes named; attributed testimonies are
            being collected by the Presidential Press Unit for the anniversary edition — see
            <a href="/sources" class="underline decoration-gold decoration-1 underline-offset-4 hover:text-gold-hi">sources</a>.
          </p>
        </div>
      </div>

      <div class="col-span-12 md:col-span-8">
        {
          voices.map((v, i) => (
            <figure class="voice-panel border-t border-line py-14 first:border-t-0 first:pt-0 md:py-20" data-reveal>
              <blockquote class="display-l max-w-[24ch] !text-[clamp(1.9rem,3.9vw,3.6rem)] text-cream">
                “{v.data.quote}”
              </blockquote>
              <figcaption class="stamp mt-8 text-mist">
                <span class="text-gold">{v.data.name}</span> · {v.data.place} · {v.data.programme}
                <span class="tnum text-mist/60"> · TESTIMONY {String(i + 1).padStart(2, '0')}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</Chapter>
