---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Path from site root, e.g. "/sources" — used for canonical + OG */
  path?: string;
  ogImage?: string;
  jsonLd?: object[];
  bodyClass?: string;
}

const {
  title,
  description,
  path = '/',
  ogImage = '/images/social/og-cover.jpg',
  jsonLd = [],
  bodyClass = '',
} = Astro.props;

const site = Astro.site ?? new URL('https://fortyyears.go.ug');
const canonical = new URL(path, site).href;
const ogImageAbs = new URL(ogImage, site).href;

const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'GovernmentOrganization',
    name: 'Republic of Uganda — State House',
    url: site.href,
    logo: new URL('/images/graphics/seal-40.svg', site).href,
    sameAs: ['https://www.statehouse.go.ug'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'Forty Years of Transformation · Republic of Uganda · 1986–2026',
    about: 'The official forty-year national record of the Republic of Uganda, 1986–2026.',
    inLanguage: 'en',
    datePublished: '2026',
    publisher: { '@type': 'GovernmentOrganization', name: 'Republic of Uganda — State House' },
    url: site.href,
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Security: full policy (incl. frame-ancestors) ships via platform headers (public/_headers). -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0E14" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Forty Years of Transformation · Republic of Uganda" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_UG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Self-hosted type: TeX Gyre Heros (GUST Font Licence) -->
    <link rel="preload" href="/fonts/heros-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heros-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heros-cn-bold.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
  </head>
  <body class={`bg-navy text-mist-bright antialiased ${bodyClass}`}>
    <a
      href="#main"
      class="eyebrow sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-gold focus:px-6 focus:py-3 focus:text-navy"
    >
      Skip to the record
    </a>
    <slot />

    <!-- Privacy-first, first-party page beacon. No cookies, no identifiers,
         fires only after explicit consent (see ConsentNotice island). -->
    <script is:inline>
      window.__recordConsent = {
        granted: localStorage.getItem('fy-consent') === 'granted',
        beacon() {
          if (!this.granted || !navigator.sendBeacon) return;
          try {
            navigator.sendBeacon(
              '/collect',
              JSON.stringify({ p: location.pathname, r: document.referrer ? 1 : 0, w: innerWidth }),
            );
          } catch {}
        },
      };
      window.__recordConsent.beacon();
    </script>
  </body>
</html>
